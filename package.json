{
  "name": "shashbesh-ai",
  "version": "0.3.1-alpha",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build:public-preview",
    "build:public-preview": "tsc --noEmit && vite build apps/web --mode cloudflare-preview && node scripts/verify-public-preview.mjs",
    "test": "node --import tsx scripts/test-public.ts"
  },
  "dependencies": {
    "@capacitor/android": "7.6.9",
    "@capacitor/core": "7.6.9",
    "@noble/hashes": "^1.8.0",
    "bonjour-service": "1.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.9",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "8.18.2",
    "fast-check": "^3.23.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
